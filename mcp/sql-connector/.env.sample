# Sample environment configuration for sql-connector MCP server

NODE_ENV=production

# Microsoft SQL Server (MSSQL)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SalesDB
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword123!

# Oracle Database
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=scott
ORACLE_PASSWORD=tiger

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=analytics_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# MongoDB
MONGODB_URI=mongodb://localhost:27017/shop

# SQLite
SQLITE_FILE_PATH=C:/data/app.db

# MS Access
MSACCESS_FILE_PATH=C:/legacy_apps/inventory.accdb

# MySQL / MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=app_db
MYSQL_USER=root
MYSQL_PASSWORD=root_password

