{
  "name": "nodejs-executor-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for executing JavaScript/TypeScript code, evaluating expressions, and running Node.js scripts",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nodejs",
    "javascript",
    "typescript",
    "executor",
    "sandbox"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nodejs-executor": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types tests/executor.test.ts && node --experimental-strip-types tests/mcp-client.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
