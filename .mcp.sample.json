{
  "$schema": "https://json.schemastore.org/partial-mcp-config.json",
  "mcpServers": {
    "sql-connector": {
      "command": "node",
      "args": [
        "--experimental-sqlite",
        "<path-to-repo>/mcp/sql-connector/dist/index.js"
      ],
      "env": {
        "NODE_ENV": "production"
      }
    },
    "nodejs-executor": {
      "command": "node",
      "args": [
        "<path-to-repo>/mcp/nodejs-executor/dist/index.js"
      ]
    },
    "project-memory": {
      "command": "node",
      "args": [
        "--experimental-sqlite",
        "<path-to-repo>/mcp/project-memory/dist/index.js"
      ]
    }
  }
}
